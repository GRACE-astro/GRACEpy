#!/bin/bash -l
# Standard output and error:
#SBATCH -o ./job.out.%j
#SBATCH -e ./job.err.%j
# Initial working directory:
#SBATCH -D @JOBDIR@
# Job name
#SBATCH -J @JOBNAME@
#
#SBATCH --partition=@QUEUE@
#SBATCH --nodes=@N_NODES@            
#SBATCH --constraint="gpu"                  
#SBATCH --gres=gpu:a100:@GPUS_PER_NODE@    
#SBATCH --ntasks-per-node=@TASKS_PER_NODE@  
#SBATCH --cpus-per-task=@CPUS_PER_TASK@
#SBATCH --mem=@MEM@
#SBATCH --mail-type=@MAIL_WHEN@
#SBATCH --mail-user=@USER_MAIL@
#SBATCH --time=@WALLTIME@


cd @JOBDIR@

module purge
source @ENV_FILE@

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OMP_PLACES=cores

# Add clang's runtime-library dir to the path. libomp.so (pulled in by Kokkos's
# OpenMP host backend) lives next to the other clang runtime libs, NOT in
# -print-runtime-dir (that is compiler-rt). -print-file-name resolves the actual
# location regardless of the per-target vs flat lib layout.
export LD_LIBRARY_PATH=$(dirname $(clang++ -print-file-name=libomp.so)):$LD_LIBRARY_PATH


srun ./grace --grace-parfile @PARAMETER_FILE@